# Copy this file to ".env" (same folder) and fill in your own key.
# ".env" is git-ignored — it will never be committed or uploaded.
#
# Required for the Conversational Coach feature only. Everything else in
# the app (Today view, quizzes, tracker, portfolio, resume, jobs) works
# without this.
#
# Get a key at https://console.anthropic.com (Settings -> API Keys).
# Note: this is a separate account/billing setup from a claude.ai
# subscription — API usage is billed per-token, pay-as-you-go.
ANTHROPIC_API_KEY=

# Optional overrides — safe to leave commented out.
# Default is claude-sonnet-5 (cheaper, plenty capable for a conversational
# coach). Uncomment to use Opus-tier quality instead, at ~5x the cost.
# COACH_MODEL=claude-opus-5
# COACH_EFFORT=medium
# COACH_MAX_TOKENS=1024
